# ── TIC Contest Backend — Environment Configuration ──
# Copy this file to .env and fill in your values.

# Database connection string
# Dev (SQLite):  file:./dev.db
# Prod (Postgres): postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# JWT signing key — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING"

# Redis connection (for submission queue + rate limiting)
REDIS_URL="redis://127.0.0.1:6379"

# Judge0 code execution server
JUDGE0_URL="http://127.0.0.1:2358"

# CORS allowed origins (comma-separated, no spaces)
# Use * only in development
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# ── Docker Compose Postgres (optional, for production) ──
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="ticcontest"
